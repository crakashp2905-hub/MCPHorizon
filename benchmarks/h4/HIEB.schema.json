  "schema_version",
  "id",
  "suite",
  "scenario",
  "family",
  "kind",
  "fixture_kind",
  "summary",
  "requirements",
  "oracle",
  "expectation",
  "report",
  "benign_control",
  "stable_id_digest"
 ],
