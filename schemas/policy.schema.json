{
  "$id": "https://mcphorizon.invalid/schemas/policy/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "horizon.security/v2"
    },
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "evaluation_timeout": {
          "const": "DENY"
        },
        "inspection_only": {
          "enum": [
            "QUARANTINE",
            "DENY"
          ]
        },
        "protected_effect": {
          "const": "DENY"
        }
      },
      "required": [
        "protected_effect",
        "inspection_only",
        "evaluation_timeout"
      ],
      "type": "object"
    },
    "kind": {
      "const": "PolicyBundle"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
          "type": "string"
        },
        "owner": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
          "type": "string"
        },
        "signature": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "owner",
        "signature"
      ],
      "type": "object"
    },
    "principals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowed_purposes": {
            "items": {
              "pattern": "^(?:[a-z][a-z0-9_]{0,63})$",
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "id": {
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidentiality": {
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "SECRET"
            ]
          },
          "match": {
            "additionalProperties": false,
            "properties": {
              "class": {
                "pattern": "^(?:[a-z][a-z0-9_.-]{0,63})$",
                "type": "string"
              }
            },
            "required": [
              "class"
            ],
            "type": "object"
          }
        },
        "required": [
          "match",
          "confidentiality"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "ALLOW",
              "DENY",
              "REVIEW",
              "QUARANTINE",
              "UNKNOWN"
            ]
          },
          "id": {
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
            "type": "string"
          },
          "when": {
            "additionalProperties": false,
            "properties": {
              "authorized_flow": {
                "type": "boolean"
              },
              "effect": {
                "enum": [
                  "read",
                  "list",
                  "write",
                  "modify",
                  "delete",
                  "execute",
                  "send",
                  "receive",
                  "admin"
                ]
              },
              "input_label_at_least": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "CONFIDENTIAL",
                  "SECRET"
                ]
              },
              "lineage_complete": {
                "type": "boolean"
              },
              "maximum_input_label": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "CONFIDENTIAL",
                  "SECRET"
                ]
              },
              "purpose": {
                "pattern": "^(?:[a-z][a-z0-9_]{0,63})$",
                "type": "string"
              },
              "sink_zone": {
                "pattern": "^(?:[a-z][a-z0-9_]{0,63})$",
                "type": "string"
              },
              "unknown_effect_or_destination": {
                "type": "boolean"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "id",
          "when",
          "decision"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "rules",
    "defaults"
  ],
  "title": "PolicyBundle",
  "type": "object"
}
