{
  "$id": "https://mcphorizon.invalid/schemas/decision/2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_principal": {
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
      "type": "string"
    },
    "bound_args_digest": {
      "pattern": "^(?:sha256:[0-9a-f]{64})$",
      "type": "string"
    },
    "bound_target_digest": {
      "pattern": "^(?:sha256:[0-9a-f]{64})$",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
      "type": "string"
    },
    "event_id": {
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
      "type": "string"
    },
    "expires_at": {
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)$",
      "type": "string"
    },
    "horizon_witnesses": {
      "items": {
        "maxLength": 256,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "idempotency_key": {
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127})$",
      "type": "string"
    },
    "mode": {
      "enum": [
        "enforce",
        "shadow"
      ]
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "pattern": "^(?:[A-Z][A-Z0-9_]{1,63})$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "required_approval": {
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "pattern": "^(?:[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})$",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "ALLOW",
        "DENY",
        "REVIEW",
        "QUARANTINE",
        "UNKNOWN",
        "SHADOW_ALLOW"
      ]
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "policy_version",
    "event_id",
    "verdict",
    "reason_codes",
    "mode"
  ],
  "title": "Decision",
  "type": "object"
}
