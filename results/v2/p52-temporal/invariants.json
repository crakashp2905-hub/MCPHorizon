 "invariants": [
  {
   "holds_on_suite": true,
   "id": "I1",
   "name": "NO_STALE_EFFECT",
   "scope": "supported sink (conditional, atomic with the gateway), revocation feed up, authoritative clock",
   "statement": "for every attack scenario and every interleaving of its steps, the full gateway produces no effect the oracle judges prohibited or stale"
  },
  {
   "holds_on_suite": true,
   "id": "I2",
   "name": "BENIGN_LIVENESS",
   "scope": "same as I1",
   "statement": "for every benign scenario and every interleaving, the expected effect occurs exactly as expected, with a re-approval only where the state really changed"
  },
  {
   "holds_on_suite": true,
   "id": "I3",
   "name": "UNKNOWN_NOT_VERIFIED",
   "scope": "external sinks U01, U02",
   "statement": "where the sink cannot be conditioned or applies the effect later, every violating interleaving is reported UNKNOWN by the gateway; none is reported as a verified success"
  },
  {
   "holds_on_suite": true,
   "id": "I4",
   "name": "FAIL_CLOSED",
   "scope": "feed offline scenarios F01, F02",
   "statement": "with the revocation feed offline the gateway never produces an effect on a revoked approval; it returns UNKNOWN"
  },
  {
   "holds_on_suite": true,
   "id": "I5",
   "name": "SINGLE_COMMIT",
