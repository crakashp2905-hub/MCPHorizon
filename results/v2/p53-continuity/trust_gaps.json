   "id": "C1",
   "statement": "a migration is admitted only if the target's fresh, identity-bound attestation covers every mandatory control of the source contract"
  },
  {
   "holds_on_suite": true,
   "id": "C2",
   "statement": "no raw credential or secret appears in a serialized envelope; the target receives a broker-issued, runtime-bound credential and the source's is revoked"
  },
  {
   "holds_on_suite": true,
   "id": "C3",
   "statement": "transferred authority never exceeds the authoritative grant (permissions, principal chain, labels)"
  },
  {
   "holds_on_suite": true,
   "id": "C4",
   "statement": "an envelope resumes at most once; a failed admission leaves the source unchanged or safe-stopped and consumes nothing"
  },
  {
   "holds_on_suite": true,
   "id": "C5",
   "statement": "expired approvals are not carried; revoked policy handles and an unreadable revocation feed deny admission"
  }
